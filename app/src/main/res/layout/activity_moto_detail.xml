<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/moto_details"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:navigationContentDescription="@string/navigate_back" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp">
            <ProgressBar android:id="@+id/progress"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/loading" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" app:cardCornerRadius="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="24dp">
                    <TextView android:id="@+id/tvMotoNome"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        tools:text="Honda CG 160" />
                    <TextView android:id="@+id/tvMotoAno"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" tools:text="Ano: 2024" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" android:text="@string/moto_km_hint" />
                    <TextView android:id="@+id/tvMotoKm"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="?attr/colorPrimary" tools:text="12.500 km" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" android:text="@string/moto_plate_label" />
                    <TextView android:id="@+id/tvMotoPlaca"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium" tools:text="ABC1D23" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/expenses_title"
                android:textAppearance="?attr/textAppearanceTitleLarge" />
            <TextView android:id="@+id/tvResumoGastos"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodyLarge" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnNovoAbastecimento"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/new_fuel"
                android:enabled="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnNovaManutencao"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/new_maintenance"
                android:enabled="false" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnEditarMoto"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/btn_editar" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnExcluirMoto"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/btn_excluir"
                android:textColor="?attr/colorError" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/schedule_title"
                android:textAppearance="?attr/textAppearanceTitleLarge" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginBottom="16dp"
                android:text="@string/schedule_hint" />
            <TextView android:id="@+id/tvPrevisoesVazio"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/schedule_empty" android:visibility="gone" />
            <LinearLayout android:id="@+id/containerPrevisoes"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/fuel_history"
                android:textAppearance="?attr/textAppearanceTitleLarge" />
            <TextView android:id="@+id/tvResumoCombustivel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginBottom="16dp" />
            <TextView android:id="@+id/tvHistoricoVazio"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/fuel_empty" android:visibility="gone" />
            <LinearLayout android:id="@+id/containerAbastecimentos"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/maintenance_history"
                android:textAppearance="?attr/textAppearanceTitleLarge" />
            <TextView android:id="@+id/tvResumoManutencoes"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginBottom="16dp" />
            <TextView android:id="@+id/tvManutencoesVazio"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/maintenance_empty" android:visibility="gone" />
            <LinearLayout android:id="@+id/containerManutencoes"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
